[Unit]
Description=Minecraft Server UI manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minecraft-ui
Group=minecraft-ui
Environment=MINECRAFT_UI_DATA_DIR=/var/lib/minecraft-ui
Environment=MINECRAFT_UI_ADDR=127.0.0.1:8080
EnvironmentFile=-/etc/minecraft-ui/environment
ExecStart=/usr/local/bin/minecraft-ui serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=150s
UMask=0077
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minecraft-ui
PrivateTmp=true
ProtectControlGroups=true
# Mount-only protection preserves the fixed sudo helper on systemd 249/252.
ReadOnlyPaths=/proc/sys /sys
InaccessiblePaths=-/dev/kmsg -/proc/kmsg
# ProtectKernelTunables/Modules/Logs and RestrictSUIDSGID implicitly enable
# NoNewPrivileges for User= services on older systemd via seccomp. Do not add
# them (or NoNewPrivileges) here: the fixed root-owned helper requires setuid
# sudo. The unprivileged manager retains filesystem isolation above; game
# units retain their full seccomp, namespace and NoNewPrivileges restrictions.

[Install]
WantedBy=multi-user.target
