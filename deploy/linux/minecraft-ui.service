[Unit]
Description=Minecraft Server UI manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minecraft-ui
Group=minecraft-ui
Environment=MINECRAFT_UI_DATA_DIR=/var/lib/minecraft-ui
Environment=MINECRAFT_UI_ADDR=127.0.0.1:8080
EnvironmentFile=-/etc/minecraft-ui/environment
ExecStart=/usr/local/bin/minecraft-ui serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
UMask=0077
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minecraft-ui
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# NoNewPrivileges is intentionally absent: the only sudo grant is the fixed,
# root-owned unitctl helper. Games have NoNewPrivileges=true in their own units.

[Install]
WantedBy=multi-user.target
