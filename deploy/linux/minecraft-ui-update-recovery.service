[Unit]
Description=Recover interrupted Minecraft UI executable activation
Before=minecraft-ui.service
# This required oneshot must be eligible on every manager activation. The
# manager service retains its own restart rate limit.
StartLimitIntervalSec=0

[Service]
# Intentionally not RemainAfterExit: every ordinary start rechecks recovery,
# including a restart after an interrupted updater in the same boot. The helper
# accepts a launch permit only from the live kernel-lock-owning fixed worker.
Type=oneshot
User=root
Group=root
# Retain the capability needed by the fixed unprivileged schema probe.
AmbientCapabilities=CAP_SETUID
ExecStart=/usr/local/lib/minecraft-ui/selfupdate recover
TimeoutStartSec=4min
UMask=0077
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/usr/local/bin /var/lib/minecraft-ui-update /var/lib/minecraft-ui
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
NoNewPrivileges=true
