[Unit]
Description=Verified Minecraft UI executable activation and recovery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
# systemd 255's seccomp setup drops SETUID unless retained in the ambient set.
# The fixed manager-account probe must drop from root to minecraft-ui.
AmbientCapabilities=CAP_SETUID
ExecStart=/usr/local/lib/minecraft-ui/selfupdate run %i
# 9min operation budget + independent 5min cleanup + service margin.
TimeoutStartSec=15min
UMask=0077
# Independent from minecraft-ui.service: this worker must survive its stop.
# It controls only the fixed manager unit and fixed executable. No caller paths.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/usr/local/bin /var/lib/minecraft-ui-update /var/lib/minecraft-ui
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
NoNewPrivileges=true
