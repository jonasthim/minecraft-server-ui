    $trustWriter = [MinecraftUiOuter.PrivateIO]::OpenBound($trustPath,$ownedFiles['trust.json'],$fileSDDL,$true,$false)
    try {
        $trustBytes = [Convert]::FromBase64String('{{.TrustBase64}}')
        $trustWriter.Write($trustBytes,0,$trustBytes.Length)
