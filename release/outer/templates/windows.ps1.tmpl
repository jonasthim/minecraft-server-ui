function Refuse([string]$Message) { throw [System.InvalidOperationException]::new($Message) }
function Initialize-PrivateIO {
    # Windows PowerShell and PowerShell 7 have different ACL FileStream APIs.
    # This small Win32 adapter gives both the same atomic CREATE_NEW security,
    # handle-bound identity checks and handle-bound deletion. No post-create ACL
    # repair is used and every error is scrubbed by the outer authored handler.
    Add-Type -Language CSharp -TypeDefinition @'
using System;
using System.ComponentModel;
using System.IO;
using System.Runtime.InteropServices;
using System.Security.AccessControl;
using Microsoft.Win32.SafeHandles;
namespace MinecraftUiOuter {
    public static class PrivateIO {
        const uint Read = 0x80000000, Write = 0x40000000;
        const uint Delete = 0x10000, ReadControl = 0x20000, ReadAttributes = 0x80;
        const uint OpenReparse = 0x00200000, BackupSemantics = 0x02000000;
        const uint Directory = 0x10, Reparse = 0x400;
        [StructLayout(LayoutKind.Sequential)]
        struct SecurityAttributes { public int Length; public IntPtr Descriptor; [MarshalAs(UnmanagedType.Bool)] public bool Inherit; }
        [StructLayout(LayoutKind.Sequential)]
        struct FileTime { public uint Low; public uint High; }
        [StructLayout(LayoutKind.Sequential)]
        struct FileInfo {
            public uint Attributes; public FileTime Creation, Access, Write;
            public uint Volume, SizeHigh, SizeLow, Links, IndexHigh, IndexLow;
        }
        [StructLayout(LayoutKind.Sequential)]
        struct Disposition { [MarshalAs(UnmanagedType.U1)] public bool DeleteFile; }
        [DllImport("advapi32.dll", CharSet=CharSet.Unicode, ExactSpelling=true, SetLastError=true)]
        static extern bool ConvertStringSecurityDescriptorToSecurityDescriptorW(string sddl, uint revision, out IntPtr descriptor, out uint size);
        [DllImport("advapi32.dll", SetLastError=true)]
        static extern uint GetSecurityDescriptorLength(IntPtr descriptor);
        [DllImport("advapi32.dll", SetLastError=true)]
        static extern uint GetSecurityInfo(SafeFileHandle handle, uint kind, uint information, out IntPtr owner, out IntPtr group, out IntPtr dacl, out IntPtr sacl, out IntPtr descriptor);
        [DllImport("kernel32.dll", CharSet=CharSet.Unicode, ExactSpelling=true, SetLastError=true)]
        static extern SafeFileHandle CreateFileW(string path, uint access, uint share, ref SecurityAttributes security, uint creation, uint flags, IntPtr template);
        [DllImport("kernel32.dll", SetLastError=true)]
        static extern bool GetFileInformationByHandle(SafeFileHandle handle, out FileInfo information);
        [DllImport("kernel32.dll", SetLastError=true)]
        static extern bool SetFileInformationByHandle(SafeFileHandle handle, uint kind, ref Disposition information, uint size);
        [DllImport("kernel32.dll")]
        static extern IntPtr LocalFree(IntPtr memory);
        static Exception Failure() { return new IOException("private scratch operation refused"); }
        static SafeFileHandle Open(string path, uint access, uint share, uint creation, bool directory, string sddl) {
            IntPtr descriptor = IntPtr.Zero;
            try {
                if (sddl != null) { uint size; if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl,1,out descriptor,out size)) throw Failure(); }
                SecurityAttributes security = new SecurityAttributes();
                security.Length = Marshal.SizeOf(typeof(SecurityAttributes)); security.Descriptor = descriptor;
                SafeFileHandle handle = CreateFileW(path,access,share,ref security,creation,OpenReparse | (directory ? BackupSemantics : 0),IntPtr.Zero);
                if (handle.IsInvalid) { handle.Dispose(); throw Failure(); }
                return handle;
            } finally { if (descriptor != IntPtr.Zero) LocalFree(descriptor); }
        }
        static FileInfo Information(SafeFileHandle handle, bool directory) {
            FileInfo info;
            if (!GetFileInformationByHandle(handle,out info) || (info.Attributes & Reparse) != 0 || ((info.Attributes & Directory) != 0) != directory || (!directory && info.Links != 1)) throw Failure();
            return info;
        }
        static string Identity(FileInfo info) { return info.Volume.ToString("x8")+":"+info.IndexHigh.ToString("x8")+info.IndexLow.ToString("x8"); }
        static string[] Rules(RawAcl acl) {
            if (acl == null) throw Failure();
            string[] rules = new string[acl.Count];
            for (int i=0;i<acl.Count;i++) { byte[] bytes=new byte[acl[i].BinaryLength]; acl[i].GetBinaryForm(bytes,0); rules[i]=Convert.ToBase64String(bytes); }
            Array.Sort(rules,StringComparer.Ordinal); return rules;
        }
        static void Security(SafeFileHandle handle, string sddl) {
            IntPtr owner,group,dacl,sacl,descriptor;
            uint result=GetSecurityInfo(handle,1,5,out owner,out group,out dacl,out sacl,out descriptor);
            if (result != 0) throw Failure();
            try {
                uint size=GetSecurityDescriptorLength(descriptor);
                if (size < 20 || size > 65536) throw Failure();
                byte[] bytes=new byte[(int)size]; Marshal.Copy(descriptor,bytes,0,bytes.Length);
                RawSecurityDescriptor actual=new RawSecurityDescriptor(bytes,0), expected=new RawSecurityDescriptor(sddl);
                if (actual.Owner == null || !actual.Owner.Equals(expected.Owner) || (actual.ControlFlags & ControlFlags.DiscretionaryAclProtected)==0) throw Failure();
                string[] a=Rules(actual.DiscretionaryAcl), e=Rules(expected.DiscretionaryAcl);
                if (a.Length != e.Length) throw Failure();
                for (int i=0;i<a.Length;i++) if (!String.Equals(a[i],e[i],StringComparison.Ordinal)) throw Failure();
            } finally { if (descriptor != IntPtr.Zero) LocalFree(descriptor); }
        }
        public static void AssertBound(SafeFileHandle handle, string identity, string sddl, bool directory) {
            if (!String.Equals(Identity(Information(handle,directory)),identity,StringComparison.Ordinal)) throw Failure();
            Security(handle,sddl);
        }
        public static string CreatePrivateFile(string path, string sddl) {
            // Security owner and protected DACL are applied by CREATE_NEW itself.
            using (SafeFileHandle handle=Open(path,Read|Write,7,1,false,sddl)) {
                Security(handle,sddl); return Identity(Information(handle,false));
            }
        }
        public static SafeFileHandle BindDirectory(string path, string sddl) {
            SafeFileHandle handle=Open(path,ReadControl|ReadAttributes,3,3,true,null);
            try { Information(handle,true); Security(handle,sddl); return handle; } catch { handle.Dispose(); throw; }
        }
        public static string DirectoryIdentity(SafeFileHandle handle) { return Identity(Information(handle,true)); }
        public static FileStream OpenBound(string path, string identity, string sddl, bool writable, bool output) {
            // Output readers allow PowerShell's existing-file writers, but no
            // handle allows deletion while retained. Other readers forbid writes.
            SafeFileHandle handle=Open(path,Read|(writable?Write:0),output?3u:1u,3,false,null);
            try { AssertBound(handle,identity,sddl,false); return new FileStream(handle,writable?FileAccess.ReadWrite:FileAccess.Read); } catch { handle.Dispose(); throw; }
        }
        public static void DeleteOwned(string path, string identity, string sddl, bool directory) {
            // A renamed/replaced path is never deleted. Security and identity
            // are checked on the exact DELETE handle used for disposition.
            using (SafeFileHandle handle=Open(path,Delete|ReadControl|ReadAttributes,7,3,directory,null)) {
                AssertBound(handle,identity,sddl,directory);
                Disposition disposition=new Disposition(); disposition.DeleteFile=true;
                if (!SetFileInformationByHandle(handle,4,ref disposition,1)) throw Failure();
            }
        }
    }
}
'@
}
function New-PrivateScratchFile([string]$Name) {
    if ($Name -cnotin @('trust.json','minecraft-ui-bootstrap.exe','result.json','error.txt') -or $ownedFiles.ContainsKey($Name)) { Refuse 'unexpected scratch child' }
    Assert-Scratch $scratch $scratchIdentity
    [MinecraftUiOuter.PrivateIO]::AssertBound($scratchHandle,$scratchID,$directorySDDL,$true)
    $path = [System.IO.Path]::Combine($scratch,$Name)
    $ownedFiles.Add($Name,[MinecraftUiOuter.PrivateIO]::CreatePrivateFile($path,$fileSDDL))
    return $path
}
function Assert-NoReparse([string]$Path) {
    $item = [System.IO.DirectoryInfo]::new($Path)
    while ($null -ne $item) {
        if (-not $item.Exists -or (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0)) { Refuse 'unsafe path ancestry' }
        $item = $item.Parent
    }
}
function Assert-Scratch([string]$Path, [System.Security.AccessControl.DirectorySecurity]$Expected) {
    Assert-NoReparse $Path
    $actual = Get-Acl -LiteralPath $Path
    $sidType = [System.Security.Principal.SecurityIdentifier]
    if (-not $actual.AreAccessRulesProtected -or $actual.GetOwner($sidType).Value -cne $Expected.GetOwner($sidType).Value) { Refuse 'private scratch security changed' }
    # Compare exact rules, avoiding irrelevant OS auto-inheritance SDDL flags.
    $actualRules = @($actual.GetAccessRules($true,$true,$sidType) | ForEach-Object { '{0}|{1}|{2}|{3}|{4}|{5}' -f $_.IdentityReference.Value,[int]$_.FileSystemRights,[int]$_.AccessControlType,[int]$_.InheritanceFlags,[int]$_.PropagationFlags,$_.IsInherited } | Sort-Object)
    $expectedRules = @($Expected.GetAccessRules($true,$true,$sidType) | ForEach-Object { '{0}|{1}|{2}|{3}|{4}|{5}' -f $_.IdentityReference.Value,[int]$_.FileSystemRights,[int]$_.AccessControlType,[int]$_.InheritanceFlags,[int]$_.PropagationFlags,$_.IsInherited } | Sort-Object)
    if (($actualRules -join ';') -cne ($expectedRules -join ';')) { Refuse 'private scratch security changed' }
}
function Assert-Redirect([string]$Location) {
    if ($Location.Length -gt 32768 -or $Location -match '[\x00-\x20\x7f]') { Refuse 'untrusted download redirect' }
    $next = $null
    if (-not [System.Uri]::TryCreate($Location,[System.UriKind]::Absolute,[ref]$next) -or $next.Scheme -cne 'https' -or $next.Host -cne 'release-assets.githubusercontent.com' -or $next.Port -ne 443 -or $next.UserInfo -ne '' -or $next.Fragment -ne '') { Refuse 'untrusted download redirect' }
    return $next.AbsoluteUri
}
function Receive-Preparer([string]$Url, [System.IO.Stream]$Destination, [long]$ExpectedSize) {
    $deadline = [System.Diagnostics.Stopwatch]::StartNew()
    for ($redirect = 0; $redirect -lt 4; $redirect++) {
        $request = [System.Net.HttpWebRequest]::Create($Url)
        $request.Proxy = $null
        $request.Credentials = $null
        $request.UseDefaultCredentials = $false
        $request.PreAuthenticate = $false
        $request.AllowAutoRedirect = $false
        $request.Timeout = 15000
        $request.ReadWriteTimeout = 15000
        $response = $null
        try {
            $response = $request.GetResponse()
            $status = [int]$response.StatusCode
            if ($status -in @(301,302,303,307,308)) {
                $Url = Assert-Redirect ([string]$response.Headers['Location'])
                continue
            }
            if ($status -ne 200 -or $response.ContentLength -gt $ExpectedSize) { Refuse 'preparer download refused' }
            $source = $response.GetResponseStream()
            try {
                $buffer = New-Object byte[] 65536
                [long]$total = 0
                while (($count = $source.Read($buffer,0,[int][Math]::Min($buffer.Length,($ExpectedSize - $total + 1)))) -gt 0) {
                    $total += $count
                    if ($total -gt $ExpectedSize -or $deadline.Elapsed.TotalSeconds -gt 120) { Refuse 'preparer download exceeds bounds' }
                    $Destination.Write($buffer,0,$count)
                }
                if ($total -ne $ExpectedSize) { Refuse 'preparer size mismatch' }
                $Destination.Flush()
            } finally { $source.Dispose() }
            return
        } finally { if ($null -ne $response) { $response.Dispose() }; $request.Abort() }
    }
    Refuse 'preparer redirect limit exceeded'
}
try {
    if ($env:OS -ne 'Windows_NT' -or -not [Environment]::Is64BitOperatingSystem -or -not [Environment]::Is64BitProcess) { Refuse 'requires x64 Windows PowerShell' }
    if ($Version -cne 'latest' -and $Version -cnotmatch '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\z') { Refuse 'invalid manager version' }
