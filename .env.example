MINECRAFT_UI_ADDR=127.0.0.1:8080
MINECRAFT_UI_DATA_DIR=./data
MINECRAFT_UI_BASE_URL=http://127.0.0.1:8080
# Plain HTTP loopback development defaults to non-Secure cookies.
# Production: set BASE_URL to the externally visible HTTPS origin.
# MINECRAFT_UI_INSECURE_COOKIES=false

# Vite development: run make dev-backend and make dev-web, then open
# http://127.0.0.1:5173. The backend target sets that exact public origin.
# Standalone backend: defaults above serve the embedded UI on port 8080.
